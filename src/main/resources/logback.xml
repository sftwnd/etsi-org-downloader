<configuration>

    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Stop the context on JVM exit: AsyncAppender works in a daemon thread and flushes its queue only on stop -->
    <shutdownHook/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%green(%date{ISO8601}) %highlight(%-5level) %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>500</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="STDOUT"/>
    </appender>

    <logger name="com.github.sftwnd.etsiorg" level="INFO" additivity="false"><appender-ref ref="ASYNC"/></logger>

    <root level="INFO">
        <appender-ref ref="ASYNC" />
    </root>

</configuration>
